# Skopiuj do .env i uzupełnij dla środowiska docelowego.
# Nigdy nie commituj prawdziwego pliku .env.

# "development" lub "production" - steruje domyślną wartością session_cookie_secure
ENVIRONMENT=production

# Origin frontendu dopuszczony przez CORS (dokładny, bez "*" - wymagane przy allow_credentials=True)
FRONTEND_ORIGIN=https://app.twojadomena.pl

# Nazwa ciasteczka sesyjnego
SESSION_COOKIE_NAME=session_id

# Czas życia sesji w minutach (sliding expiration - odświeżany przy każdym użyciu)
SESSION_TTL_MINUTES=10080

# Wymuś ciasteczko tylko po HTTPS - w produkcji zawsze true
SESSION_COOKIE_SECURE=true

# "lax" (zalecane) lub "strict"
SESSION_COOKIE_SAMESITE=lax

# Domena ciasteczka, np. .twojadomena.pl gdy frontend i backend są na subdomenach
SESSION_COOKIE_DOMAIN=
